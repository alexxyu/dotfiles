#!/usr/bin/env bash
#
# vipe(1) - Pipe in and out of $EDITOR
#
# (c) 2014 Julian Gruber <julian@juliangruber.com>.
# MIT licensed.
#
# Examples:
#
#   $ echo foo | vipe | gist
#   $ vipe | gist
#   $ curl https://httpbin.org/post -X POST -H "Content-Type: application/json" -d "$(vipe -e=json)"
#
# This is a lightweight shell only version. For the original impementation in
# python, check https://github.com/madx/moreutils/blob/master/vipe
#
# Original source code at https://github.com/juliangruber/vipe, modified to support file extension argument.

# version

set -euo pipefail

VERSION="0.2.0"

# usage

function __vipe_usage() {
  echo "usage: vipe [-hV] [-e=EXT|--extension=EXT]"
}

ext="txt"
for i in "$@"; do
  case $i in
    "-e="* | "--extension="*)
      ext="${i#*=}"
      ;; # past argument=value
    "-h")
      __vipe_usage
      exit 0
      ;;
    "-V")
      echo "$VERSION"
      exit 0
      ;;
    --* | -*)
      echo "unknown option: \"${i}\"" >&2
      __vipe_usage >&2
      exit 1
      ;;
    *)
      echo "unexpected argument: \"${i}\"" >&2
      exit 1
      ;;
  esac
done

# Keep the extension inside the private directory, never interpret it as a path.
if [[ ! "$ext" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "invalid extension: $ext" >&2
  exit 1
fi

# A private directory works with both BSD and GNU mktemp and supports extensions.
temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/vipe.XXXXXXXXXX")
trap 'rm -rf -- "$temp_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
umask 077
t="$temp_dir/buffer.$ext"
touch "$t"

# read from stdin

if [ ! -t 0 ]; then
  cat > "$t"
fi

# spawn editor with stdio connected

# Support common values such as "nvim -f" without evaluating shell syntax.
read -r -a editor_command <<< "${VISUAL:-${EDITOR:-vi}}"
"${editor_command[@]}" "$t" < /dev/tty > /dev/tty

# write to stdout

cat "$t"

# The EXIT trap also cleans up on editor failure or a signal.
